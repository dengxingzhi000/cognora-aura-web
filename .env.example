# Copy to .env.local for development. Never commit real host names or secrets.
# Empty NEXT_PUBLIC_API_BASE_URL keeps the browser on the Next origin and uses
# the rewrites in next.config.ts (see README "API layer").
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_DEFAULT_TENANT_ID=
NEXT_PUBLIC_DEFAULT_TENANT_CODE=default
NEXT_PUBLIC_DEFAULT_TENANT_NAME=

# Rewrite targets (build-time: they are baked into the standalone output).
API_AUTH_TARGET=http://localhost:8106
API_SYSTEM_TARGET=http://localhost:8081
API_PRODUCT_TARGET=http://localhost:8201
API_INVENTORY_TARGET=http://localhost:8202
API_ORDER_TARGET=http://localhost:8203
API_WAREHOUSE_TARGET=http://localhost:8204
API_LOGISTICS_TARGET=http://localhost:8205
API_SUPPLIER_TARGET=http://localhost:8206
API_PURCHASE_TARGET=http://localhost:8207
API_FINANCE_TARGET=http://localhost:8208
API_APPROVAL_TARGET=http://localhost:8209
API_AUDIT_TARGET=http://localhost:8210
API_NOTIFY_TARGET=http://localhost:8211
API_TENANT_TARGET=http://localhost:8212
API_DOCUMENT_TARGET=http://localhost:8213
API_FILE_TARGET=http://localhost:8214
API_ANALYTICS_TARGET=http://localhost:8308
API_MALL_TARGET=http://localhost:8301
API_MEMBER_TARGET=http://localhost:8302
API_PROMOTION_TARGET=http://localhost:8303
API_PAYMENT_TARGET=http://localhost:8304
API_ORDER_CENTER_TARGET=http://localhost:8305
API_FULFILLMENT_TARGET=http://localhost:8306
API_SEARCH_TARGET=http://localhost:8307
